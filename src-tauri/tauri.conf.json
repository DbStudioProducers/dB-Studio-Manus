{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dB Studio",
  "version": "0.1.0",
  "identifier": "com.dbstudio.server",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/public"
  },
  "app": {
    "windows": [
      {
        "title": "dB Studio — Server",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../mobile/assets/images/icon.png",
      "../mobile/assets/images/favicon.png"
    ],
    "category": "Music",
    "shortDescription": "Servidor pessoal de monitoramento sem fio",
    "longDescription": "Console desktop dB Studio para servidor, mixagens pessoais e transporte de áudio local."
  }
}
